<!-- Fog — fog of war as a game RULE, not a screen effect.

     The interesting failures here are not "the wrong tiles are dark". They are:
     a rule that lets you order a strike on something you cannot see (the maphack
     the feature exists to stop), an explored set that two machines compute
     differently (a desync that surfaces minutes later as a rejected order), and
     a rejoiner handed a snapshot that leaves their own map blank.

     Needs Net as well as Sim: the explored bitsets have to survive the wire, or
     a reconnecting player loses everything they ever scouted.

     Run with `dotnet run` from this directory. Exit code 0 = pass, 1 = fail. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>FogTests</RootNamespace>
    <AssemblyName>FogTests</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../game/Sim/*.cs" LinkBase="Sim" />
    <Compile Include="../../game/Net/*.cs" LinkBase="Net" />
  </ItemGroup>

</Project>
